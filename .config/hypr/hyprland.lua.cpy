--###############

--## MONITORS ###

--###############

hl.monitor({
    output   = "eDP-1",
    mode     = "1920x1080@60",
    position = "0x0",
    scale    = 1,
    vrr = 0,
})

hl.monitor({
    output   = "HDMI-A-1",
    mode     = "highrr",
    position = "-1920x0",
    scale    = 1,
})

--monitor=HDMI-A-1,3840x2160@60, -3840x0, 1, vrr, 0

