{
    "label" : "sleep",
    "action" : "loginctl lock-session && systemctl suspend",
    "text" : "[SLEEP]",
    "keybind" : "s"
}
{
    "label" : "lock",
    "action" : "qs ipc call lock lock || hyprlock",
    "text" : "[LOCK]",
    "keybind" : "l"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "[REBOOT]",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "[POWER OFF]",
    "keybind" : "p"
}
